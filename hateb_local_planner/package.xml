<?xml version="1.0"?>
<package format="3">
  <name>hateb_local_planner</name>
  <version>0.1.0</version>
  <description>
    The hateb_local_planner package implements a plugin for navigation that predicts trajectories for humans/agents
    and plans a robot trajectory that satisfies kinodynamic and social constraints.
  </description>

  <maintainer email="ptsingaman@laas.fr">Phani Teja Singamaneni</maintainer>
  <author email="ptsingaman@laas.fr">Phani Teja Singamaneni</author>
  <author email="christoph.roesmann@tu-dortmund.de">Christoph Rösmann</author>

  <license>BSD</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>tf2</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>tf2_geometry_msgs</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>interactive_markers</build_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>rclcpp_components</build_depend>
  <build_depend>visualization_msgs</build_depend>
  <build_depend>cohan_msgs</build_depend>
  <build_depend>agent_path_prediction</build_depend>
  <build_depend>costmap_converter</build_depend>
  <build_depend>std_srvs</build_depend>

  <!-- Execution dependencies -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>interactive_markers</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>cohan_msgs</exec_depend>
  <exec_depend>agent_path_prediction</exec_depend>
  <exec_depend>costmap_converter</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <!-- External libraries (handled manually in CMakeLists.txt) -->
  <exec_depend>libg2o</exec_depend>
  <!-- <exec_depend>suitesparse</exec_depend> -->

  <!-- Export pluginlib plugin -->
  <export>
    <pluginlib plugin="${prefix}/hateb_local_planner_plugin.xml"/>
  </export>
</package>
