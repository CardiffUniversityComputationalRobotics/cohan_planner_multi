<?xml version="1.0"?>
<package format="3">
  <name>cohan_msgs</name>
  <version>0.0.2</version>
  <description>
    Agent message definitions for human-aware multi-agent navigation planning.
  </description>

  <maintainer email="ptsingaman@laas.fr">Phani Teja Singamaneni</maintainer>
  <author email="ptsingaman@laas.fr">Phani Teja Singamaneni</author>
  <author email="harmish@laas.fr">Harmish Khambhaita</author>

  <license>BSD</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Message generation dependencies -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Message dependencies -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- Export info -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
